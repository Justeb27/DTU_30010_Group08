#ifndef MENUS_HELP_MENU_H_
#define MENUS_HELP_MENU_H_

void help_menu(uint8_t *nav);
void help_title_simple(uint8_t x, uint8_t y);
void help_text(uint8_t x, uint8_t y);

#endif /* MENUS_HELP_MENU_H_ */

\end{lstlisting}

\begin{lstlisting}[caption = {Helpmenu.c}]


#include "stm32f30x_conf.h" // STM32 config
#include "30010_io.h"		// Input/output library for this course
#include <menus/help_menu.h>
#include <graphics/background.h>

void help_menu(uint8_t *nav) {
	init_background();
	big_planet(170,57,4,2);
	big_planet(220,3,4,2);
	big_planet(30,3,4,2);
	help_title_simple(100,7);
	help_text(20,15);


	while (1) {

		if (read_button() == 1) {
			*nav = 0;
			clrscr();
			break;
		}
	}

}

void help_title_simple(uint8_t x, uint8_t y) {
    gotoxy(x, y);
    printf("       _   _   _____   _       ____  \n");
    gotoxy(x, y + 1);
    printf("      | | | | | ____| | |     |  _ \\ \n");
    gotoxy(x, y + 2);
    printf("      | |_| | |  _|   | |     | |_) |\n");
    gotoxy(x, y + 3);
    printf("      |  _  | | |___  | |___  |  __/ \n");
    gotoxy(x, y + 4);
    printf("      |_| |_| |_____| |_____| |_|    \n");
}

