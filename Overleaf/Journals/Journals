\subsection{Trigonometri med Look-Up Tables (LUT)(Exercise.3)}
Vi har skabt funktioner som \texttt{sinus} og \texttt{cos}, der anvender beregnede værdier i en Look-Up Table for hurtigt at beregne sinus- og cosinusværdier. Ved at bruge LUT’er har vi elimineret behovet for tunge beregninger og sikret højere ydeevne på systemer med begrænset hardwarekapacitet.

\begin{lstlisting}
uint32_t Sinus(int16_t x){
	return SIN[x];
}

uint32_t Sinfunc(int x){
	while (x < 0){
	x +=512; //If angle is negative
	}

	while (x > 512){
	x -= 512; // If angle is more than 360 degrees
	}

	return (Sinus(x));//printFix(expand(x)));
}

uint32_t Cosfunc(int16_t x){
	x += 128;
	while (x < 0){
		x +=512; //If angle is negative
	}

	while (x > 512){
		x -= 512; // If angle is more than 360 degrees
	}

	return (Sinus(x));//printFix(expand(x)));
}
\end{lstlisting}


\subsubsection{Vektorfunktioner}
Vi har implementeret funktioner som \texttt{rotateVector}, der roterer 2D-vektorer ved hjælp af trigonometri fra LUT’erne. Funktionen opdaterer koordinaterne baseret på rotationsvinklen og anvender faste punktberegninger. Dette har givet os mulighed for effektivt at manipulere vektorer og demonstrere brugen af avancerede matematiske operationer.

\begin{lstlisting}
void initVector(vector_t *v) {
	v->x = 1;
	v->y = 1;
}

void rotateVector(vector_t *v, vector_t tempVect, int z) {

	int32_t x = v -> x;
	int32_t y = v -> y;
	v->x = (tempVect.x * Cosfunc(z)) - (tempVect.y * Sinfunc(z));
	v->y = (tempVect.x * Sinfunc(z)) + (tempVect.y * Cosfunc(z));
}

\end{lstlisting}

\subsection{Ball in window (Exercise. 4)}
Projektet blev indledt med etableringen af et vindue i terminalen, som blev genbrugt fra en tidligere opgave. Boldens bevægelse blev implementeret ved at opdatere dens vektor. Når boldens x-position ramte en af vinduets sider, blev vektorens x- eller y-komponent inverteret, hvilket simulerede en refleksion og tillod bolden at "bounce" tilbage fra væggen.
Derudover blev en mindre, indre kasse initialiseret på lignende vis. For at overvåge interaktioner med denne kasse blev der implementeret en tællefunktion, som registrerede hver gang boldens bevægelsesvektor blev ændret. For at sikre, at bolden ignorerede den indre kasse, blev der indført en betinget if-else-struktur. Denne struktur kontrollerede, om bolden befandt sig inden for den indre kasses område. Hvis dette var tilfældet, blev boldens position ikke printet. Hvis bolden derimod var uden for kassen, blev dens position vist som normalt.

\begin{lstlisting}
void ball(windowsize win, int x, int y, int vx, int vy) {
// init ball speed
	vector_t myvector;
	initVector(&myvector);
	myvector.x = vx;
	myvector.y = vy;

	int counter = 0;

	while (counter < 1000) {
		if (counter < 10) {
			gotoxy(win.middlex + 3, win.middley);
			printf("%d", counter);
		}else{
			gotoxy(win.middlex + 2,win.middley);
			printf("%d",counter);
			}
		if ((x<=win.x2) && (x> win.x1) && (y <= win.y2) && (y > win.y1)); { //Inside the window
			if (!((win.middlex - 6 < x) && (x < win.middlex + 6) && (win.middley - 3 < y) && (y < win.middley + 3))) { //Not in the hitbox
				gotoxy(x,y);
				printf(" "); //Removes the ball
			}
		}

		//Calculate position
		x += myvector.x;
		y += myvector.y;

		if (y >= win.y2 - 1) {
			myvector.y = -myvector.y;
			counter += 1;
		}
		if (y <=win.y1 + 1) {
			myvector.y = -myvector.y;
			counter += 1;
		}
		if (x >= win.x2 - 1) {
			myvector.x = -myvector.x;
			counter +=1;
		}
		if (x <= win.x1 + 1) {
			myvector.x = -myvector.x;
			counter +=1;
		}

		//print o
		if ((x<=win.x2) && (x> win.x1) && (y <= win.y2) && (y > win.y1)); { //Inside the window
			if (!((win.middlex - 6 < x) && (x < win.middlex + 6) && (win.middley - 3 < y) && (y < win.middley + 3))) { //Not in the hitbox
				gotoxy(x,y);
				printf("o"); // prints the ball
			}
		}
	}
}
\end{lstlisting}



\subsection{GPIO Joystick(Exercise.5)}
Vi lavede også Exercise 5, hvor vi fokuserede på at bruge GPIO til at detektere joystick-interaktioner og styre en RGB LED. Vi fik konfigureret pins til at læse joystickets tilstand og implementerede en funktion, der aflæste retningerne. Derefter skrev vi en funktion, der ændrede LED'ens farve afhængigt af joystickets bevægelser. Til sidst testede vi koden og sikrede, at både aflæsning og farveskift fungerede korrekt. Vi nåede ikke videre til Exercise 6, men planen er at starte på den næste gang. Det var en produktiv dag med godt overblik over opgaven.

\begin{lstlisting}

#include "../Inc/Exercises/Exercise5.h"
#include "stm32f30x.h" // Include the STM32 device-specific headers


void configure_pins(void) {
    // Enable clock for GPIO Port A
    RCC->AHBENR |= RCC_AHBENR_GPIOAEN;

    // Set pin PA0 to input
    GPIOA->MODER &= ~(0x3 << (0 * 2)); // Clear mode register for PA0
    GPIOA->PUPDR &= ~(0x3 << (0 * 2)); // Clear pull-up/pull-down register for PA0
    GPIOA->PUPDR |= (0x2 << (0 * 2));  // Set pull-down for PA0
}

void configure_joystick(void) {
    // Enable clocks for GPIO ports
    RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN | RCC_AHBENR_GPIOCEN;

    // Set joystick pins to input mode
    GPIOC->MODER &= ~(0x3 << (0 * 2)); // PC0 (Right)
    GPIOA->MODER &= ~(0x3 << (4 * 2)); // PA4 (Up)
    GPIOB->MODER &= ~(0x3 << (5 * 2)); // PB5 (Center)
    GPIOC->MODER &= ~(0x3 << (1 * 2)); // PC1 (Left)
    GPIOB->MODER &= ~(0x3 << (0 * 2)); // PB0 (Down)

    // Configure pull-down resistors for joystick pins
    GPIOC->PUPDR |= (0x2 << (0 * 2)); // PC0
    GPIOA->PUPDR |= (0x2 << (4 * 2)); // PA4
    GPIOB->PUPDR |= (0x2 << (5 * 2)); // PB5
    GPIOC->PUPDR |= (0x2 << (1 * 2)); // PC1
    GPIOB->PUPDR |= (0x2 << (0 * 2)); // PB0
}

uint8_t readJoystick(void) {
    uint8_t state = 0;

    // Read joystick inputs and set bits accordingly
    state |= (GPIOA->IDR & (1 << 4)) ? (1 << 0) : 0; // Up
    state |= (GPIOB->IDR & (1 << 0)) ? (1 << 1) : 0; // Down
    state |= (GPIOC->IDR & (1 << 1)) ? (1 << 2) : 0; // Left
    state |= (GPIOC->IDR & (1 << 0)) ? (1 << 3) : 0; // Right
    state |= (GPIOB->IDR & (1 << 5)) ? (1 << 4) : 0; // Center

    return state;
}

void configure_led(void) {
    // Enable clocks for GPIO ports
    RCC->AHBENR |= RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN | RCC_AHBENR_GPIOCEN;

    // Configure PB4 (Red)
    GPIOB->MODER &= ~(0x3 << (4 * 2)); // Clear mode bits
    GPIOB->MODER |= (0x1 << (4 * 2)); // Set PB4 as output

    // Configure PC7 (Green)
    GPIOC->MODER &= ~(0x3 << (7 * 2)); // Clear mode bits
    GPIOC->MODER |= (0x1 << (7 * 2)); // Set PC7 as output

    // Configure PA9 (Blue)
    GPIOA->MODER &= ~(0x3 << (9 * 2)); // Clear mode bits
    GPIOA->MODER |= (0x1 << (9 * 2)); // Set PA9 as output
}

void setLed(uint8_t R, uint8_t G, uint8_t B) {
    // Turn off all LEDs
    GPIOB->ODR |= (1 << 4); // Turn off Red
    GPIOC->ODR |= (1 << 7); // Turn off Green
    GPIOA->ODR |= (1 << 9); // Turn off Blue

    // Turn on LEDs based on arguments
    if (R) {
        GPIOB->ODR &= ~(1 << 4); // Turn on Red
    }
    if (G) {
        GPIOC->ODR &= ~(1 << 7); // Turn on Green
    }
    if (B) {
        GPIOA->ODR &= ~(1 << 9); // Turn on Blue
    }
}

void writeJoystickToTerminal(uint8_t state) {
    printf("Joystick State: Up: %d, Down: %d, Left: %d, Right: %d, Center: %d\n",
           (state & (1 << 0)) ? 1 : 0,
           (state & (1 << 1)) ? 1 : 0,
           (state & (1 << 2)) ? 1 : 0,
           (state & (1 << 3)) ? 1 : 0,
           (state & (1 << 4)) ? 1 : 0);
}
void JoystickToLED() {
	uint8_t previousState = 0;
	int8_t currentState;

	while (1) {
		currentState = readJoystick();
		// If state has changed, write to terminal and set LED color
		if (currentState != previousState) {
			writeJoystickToTerminal(currentState);
            if (currentState == 16){ //Press in (Turn off)
                setLed(0,0,0);
            }
			if (currentState == 8) { //right (Red)
				setLed(1,0,0);
			}
			if (currentState == 4) { //left (Green)
				setLed(0,1,0);
			}
			if (currentState == 2) { //down (Blue)
				setLed(0,0,1);
			}
			if (currentState == 1) { //up - All Colours on(White light)
				setLed(1,1,1);
			}
			previousState = currentState;
		}
	}
}

\end{lstlisting}

